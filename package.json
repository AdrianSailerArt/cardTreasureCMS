{
  "name": "cardtreasure-cms",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "bun scripts/dev.ts",
    "dev:staging": "bun --env-file=.env --env-file=.env.staging scripts/dev.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:pull": "bun --bun drizzle-kit pull && rm -rf server/db/generated/meta server/db/generated/*.sql && bun scripts/fix-pulled-schema.ts",
    "import": "bun scripts/import/index.ts",
    "simulate": "bun scripts/simulate.ts",
    "testdata": "bun scripts/testdata.ts",
    "testdata:staging": "bun --env-file=.env --env-file=.env.staging scripts/testdata.ts --allow-remote",
    "make-admin": "bun scripts/make-admin.ts"
  },
  "dependencies": {
    "@cardtreasure/core": "git+ssh://git@github.com/AdrianSailerArt/cardTreasureCore.git#v0.10.1",
    "@tailwindcss/vite": "^4.3.5",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "flag-icons": "^7.6.0",
    "marked": "^18.1.3",
    "nodemailer": "^10.4.0",
    "nuxt": "^4.6.4",
    "postgres": "^4.1.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.44",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.14"
  }
}
