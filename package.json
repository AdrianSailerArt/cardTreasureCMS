{
  "name": "cardtreasure-admin",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3100",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:pull": "bun --bun drizzle-kit pull && rm -rf server/db/generated/meta server/db/generated/*.sql && bun scripts/fix-pulled-schema.ts",
    "import": "bun scripts/import/index.ts",
    "simulate": "bun scripts/simulate.ts",
    "make-admin": "bun scripts/make-admin.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "marked": "^18.1.3",
    "nuxt": "^4.6.4",
    "postgres": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "typescript": "~5.9",
    "vue-tsc": "^3.3.14"
  }
}
