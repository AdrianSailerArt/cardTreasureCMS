# Dieselbe Datenbank wie der Shop (cardTreasure). Für Produktion einen eigenen DB-Nutzer mit passenden Rechten anlegen.
NUXT_DATABASE_URL=postgres://cardtreasure:cardtreasure@localhost:5432/cardtreasure

# Eigenes Secret, unabhängig vom Shop: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=
NUXT_PUBLIC_SITE_URL=http://localhost:3100
NUXT_PUBLIC_SHOP_URL=http://localhost:3000

# Demo-Admin mit Passwort erlauben (siehe README). Im Echtbetrieb weglassen oder false.
NUXT_PUBLIC_DEMO_LOGIN=true

# Anmeldelinks an Mailpit (läuft im docker compose des Shops), Postfach http://localhost:8025
NUXT_SMTP_URL=smtp://localhost:1025

# Objektspeicher wie im Shop (Standard: SeaweedFS aus dessen docker compose, localhost:8333)
# NUXT_MEDIA_ENDPOINT=http://localhost:8333

# Interne API des Shops: gleiches Geheimnis wie im Shop, Adresse vom CMS-Server aus erreichbar
NUXT_INTERNAL_SECRET=
NUXT_SHOP_INTERNAL_URL=http://localhost:3000
